{
  "subtopicId": "sec.mathematics.algebra.inequalities",
  "questions": [
    {
      "id": "sec.mathematics.algebra.inequalities.q001",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Solve the inequality $x + 5 > 9$.",
      "options": [
        { "id": "a", "text": "$x > 4$" },
        { "id": "b", "text": "$x < 4$" },
        { "id": "c", "text": "$x > 14$" },
        { "id": "d", "text": "$x \\ge 4$" }
      ],
      "correctOptionId": "a",
      "explanation": "Subtract 5 from both sides to get $x > 4$. Subtracting a positive number does not change the direction of the sign. Note that $x = 4$ itself is not a solution, since $4 + 5 = 9$ is not greater than 9.",
      "distractorRationale": {
        "b": "Reversed the sign even though nothing was multiplied by a negative",
        "c": "Added 5 instead of subtracting it",
        "d": "Included the endpoint, but the original sign was strict"
      },
      "misconceptionTags": ["inequality-basics"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q002",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Solve the inequality $3x \\le 12$.",
      "options": [
        { "id": "a", "text": "$x \\le 4$" },
        { "id": "b", "text": "$x \\ge 4$" },
        { "id": "c", "text": "$x \\le 36$" },
        { "id": "d", "text": "$x \\le 9$" }
      ],
      "correctOptionId": "a",
      "explanation": "Divide both sides by 3, which is positive, so the sign stays the same: $x \\le 4$. The endpoint is included because the original sign included equality.",
      "distractorRationale": {
        "b": "Reversed the sign after dividing by a positive number",
        "c": "Multiplied by 3 instead of dividing",
        "d": "Subtracted 3 instead of dividing by 3"
      },
      "misconceptionTags": ["inequality-basics"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q003",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o2"],
      "type": "true_false",
      "difficulty": 1,
      "stem": "If $-x > 3$ then $x > -3$.",
      "options": [
        { "id": "a", "text": "True" },
        { "id": "b", "text": "False" }
      ],
      "correctOptionId": "b",
      "explanation": "False. Multiplying both sides by $-1$ reverses the inequality, so $-x > 3$ gives $x < -3$. You can test it: $x = -5$ satisfies $-(-5) = 5 > 3$, but $x = -5$ does not satisfy $x > -3$.",
      "misconceptionTags": ["sign-reversal"],
      "examMeta": { "board": "internal", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q004",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o1"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve the inequality $2x - 3 < 7$.",
      "options": [
        { "id": "a", "text": "$x < 2$" },
        { "id": "b", "text": "$x < 5$" },
        { "id": "c", "text": "$x > 5$" },
        { "id": "d", "text": "$x < 20$" }
      ],
      "correctOptionId": "b",
      "explanation": "Add 3 to both sides to get $2x < 10$, then divide by 2 to get $x < 5$. Both operations keep the sign the same because 2 is positive.",
      "distractorRationale": {
        "a": "Subtracted 3 from 7 instead of adding 3 to both sides",
        "c": "Reversed the sign without dividing by a negative",
        "d": "Multiplied by 2 rather than dividing"
      },
      "misconceptionTags": ["inequality-basics"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q005",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve the inequality $-2x > 8$.",
      "options": [
        { "id": "a", "text": "$x > 4$" },
        { "id": "b", "text": "$x < 4$" },
        { "id": "c", "text": "$x > -4$" },
        { "id": "d", "text": "$x < -4$" }
      ],
      "correctOptionId": "d",
      "explanation": "Divide both sides by $-2$. Because the divisor is negative, the inequality sign must reverse, giving $x < -4$. Testing $x = -5$: $-2(-5) = 10 > 8$, which confirms the answer.",
      "distractorRationale": {
        "a": "Ignored both the negative sign and the reversal",
        "b": "Reversed the sign but dropped the negative from the answer",
        "c": "Got the correct value but failed to reverse the inequality sign"
      },
      "misconceptionTags": ["sign-reversal"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q006",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve the inequality $5 - 3x \\ge 14$.",
      "options": [
        { "id": "a", "text": "$x \\ge -3$" },
        { "id": "b", "text": "$x \\le -3$" },
        { "id": "c", "text": "$x \\ge 3$" },
        { "id": "d", "text": "$x \\le 3$" }
      ],
      "correctOptionId": "b",
      "explanation": "Subtracting 5 gives $-3x \\ge 9$. Dividing by $-3$ reverses the sign, so $x \\le -3$. Checking with $x = -4$: $5 - 3(-4) = 17$, which is indeed at least 14.",
      "distractorRationale": {
        "a": "Divided by $-3$ but did not reverse the sign",
        "c": "Lost the negative sign entirely",
        "d": "Reversed the sign correctly but dropped the negative on the 3"
      },
      "misconceptionTags": ["sign-reversal"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q007",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o3"],
      "type": "numeric",
      "difficulty": 2,
      "stem": "How many integer values of $x$ satisfy $-2 < x \\le 3$? Give a number only.",
      "correctValue": 5,
      "explanation": "The strict sign at $-2$ excludes $-2$ itself, while the $\\le$ at 3 includes 3. So the integers are $-1, 0, 1, 2$ and $3$, which is 5 values. Miscounting the endpoints is the usual source of error here.",
      "misconceptionTags": ["endpoint-inclusion", "number-line"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q008",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o1"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve the inequality $\\frac{2x + 1}{3} \\le 5$.",
      "options": [
        { "id": "a", "text": "$x \\le 7$" },
        { "id": "b", "text": "$x \\le 8$" },
        { "id": "c", "text": "$x \\le 2$" },
        { "id": "d", "text": "$x \\ge 7$" }
      ],
      "correctOptionId": "a",
      "explanation": "Multiply both sides by 3 to clear the fraction: $2x + 1 \\le 15$. Subtracting 1 gives $2x \\le 14$, so $x \\le 7$.",
      "distractorRationale": {
        "b": "Divided 15 by 2 before subtracting the 1",
        "c": "Multiplied only the $2x$ by 3 and not the whole numerator",
        "d": "Reversed the sign although only positive numbers were used"
      },
      "misconceptionTags": ["clearing-fractions"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q009",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o2", "sec.mathematics.algebra.inequalities.o4"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Solve the inequality $3(x - 2) \\le 5x + 4$.",
      "options": [
        { "id": "a", "text": "$x \\le -5$" },
        { "id": "b", "text": "$x \\ge -5$" },
        { "id": "c", "text": "$x \\le 5$" },
        { "id": "d", "text": "$x \\ge -1$" }
      ],
      "correctOptionId": "b",
      "explanation": "Expanding gives $3x - 6 \\le 5x + 4$. Subtracting $5x$ and adding 6 gives $-2x \\le 10$, and dividing by $-2$ reverses the sign to give $x \\ge -5$. Testing $x = 0$: $-6 \\le 4$ is true, and 0 is indeed at least $-5$.",
      "distractorRationale": {
        "a": "Divided by $-2$ without reversing the inequality sign",
        "c": "Lost the negative sign on the 5",
        "d": "Forgot to multiply the $-2$ inside the bracket by 3"
      },
      "misconceptionTags": ["sign-reversal", "expansion"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.inequalities.q010",
      "subtopicId": "sec.mathematics.algebra.inequalities",
      "objectiveIds": ["sec.mathematics.algebra.inequalities.o4"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Find the range of values of $x$ for which $2x + 1 > 5$ and $x - 3 < 2$ are both satisfied.",
      "options": [
        { "id": "a", "text": "$2 < x < 5$" },
        { "id": "b", "text": "$x > 2$" },
        { "id": "c", "text": "$3 < x < 5$" },
        { "id": "d", "text": "$2 < x < 3$" }
      ],
      "correctOptionId": "a",
      "explanation": "The first inequality gives $2x > 4$, so $x > 2$. The second gives $x < 5$. Both must hold at once, so the overlap is $2 < x < 5$.",
      "distractorRationale": {
        "b": "Solved only the first inequality and ignored the upper limit",
        "c": "Solved $2x + 1 > 5$ as $x > 3$ by subtracting 1 from the 2x term instead",
        "d": "Used the 3 from $x - 3$ as the upper bound without solving that inequality"
      },
      "misconceptionTags": ["combined-inequality"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    }
  ]
