    {
      "id": "sec.mathematics.algebra.linear-equations.q006",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o3"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Solve for $x$: $2(x + 4) = 3(x - 1)$",
      "options": [
        { "id": "a", "text": "$x = 5$" },
        { "id": "b", "text": "$x = 7$" },
        { "id": "c", "text": "$x = 11$" },
        { "id": "d", "text": "$x = -11$" }
      ],
      "correctOptionId": "c",
      "explanation": "Expand both sides: $2x + 8 = 3x - 3$. Subtract $2x$ from both sides to get $8 = x - 3$. Add 3 to both sides to get $x = 11$. Check: $2(11 + 4) = 30$ and $3(11 - 1) = 30$.",
      "distractorRationale": {
        "a": "Failed to distribute the 3 across both terms",
        "b": "Subtracted 3 instead of adding when isolating x",
        "d": "Sign error when moving the constant across"
      },
      "misconceptionTags": ["distributive-law", "sign-error"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
