    {
      "id": "sec.mathematics.algebra.linear-equations.q003",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve for $x$: $3x + 5 = 20$",
      "options": [
        { "id": "a", "text": "$x = 5$" },
        { "id": "b", "text": "$x = \\frac{25}{3}$" },
        { "id": "c", "text": "$x = 15$" },
        { "id": "d", "text": "$x = 8\\frac{1}{3}$" }
      ],
      "correctOptionId": "a",
      "explanation": "Subtract 5 from both sides to get $3x = 15$, then divide both sides by 3 to get $x = 5$. Check: $3(5) + 5 = 20$.",
      "distractorRationale": {
        "b": "Added 5 instead of subtracting before dividing",
        "c": "Stopped at 3x = 15 without dividing",
        "d": "Same error as option b expressed as a mixed number"
      },
      "misconceptionTags": ["inverse-operation", "premature-divide"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
