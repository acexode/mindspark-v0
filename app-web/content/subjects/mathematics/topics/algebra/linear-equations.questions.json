    {
      "id": "sec.mathematics.algebra.linear-equations.q005",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o3"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve for $x$: $7x + 1 = 3x + 13$",
      "options": [
        { "id": "a", "text": "$x = 2$" },
        { "id": "b", "text": "$x = 3$" },
        { "id": "c", "text": "$x = 3.5$" },
        { "id": "d", "text": "$x = 14$" }
      ],
      "correctOptionId": "b",
      "explanation": "Subtract $3x$ from both sides to get $4x + 1 = 13$. Subtract 1 from both sides to get $4x = 12$. Divide by 4 to get $x = 3$. Check: $7(3) + 1 = 22$ and $3(3) + 13 = 22$.",
      "distractorRationale": {
        "a": "Added the x terms instead of subtracting",
        "c": "Forgot to subtract the constant 1 before dividing",
        "d": "Added 1 and 13 without collecting the x terms"
      },
      "misconceptionTags": ["collecting-like-terms"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
        "reviewStatus": "published",
        "verified": true
      }
