  "questions": [
    {
      "id": "sec.mathematics.algebra.linear-equations.q001",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Solve for $x$: $x + 7 = 12$",
      "options": [
        { "id": "a", "text": "$x = 3$" },
        { "id": "b", "text": "$x = 5$" },
        { "id": "c", "text": "$x = 12$" },
        { "id": "d", "text": "$x = 19$" }
      ],
      "correctOptionId": "b",
      "explanation": "Subtract 7 from both sides to undo the addition: $x + 7 - 7 = 12 - 7$, which gives $x = 5$. Check: $5 + 7 = 12$.",
      "distractorRationale": {
        "a": "Subtracted 7 from the wrong side or computed 12 - 9",
        "c": "Copied the right-hand side without solving",
        "d": "Added 7 instead of subtracting it"
      },
      "misconceptionTags": ["inverse-operation"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
        "reviewStatus": "published",
        "verified": true
      }
    },
    {
      "id": "sec.mathematics.algebra.linear-equations.q002",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Solve for $y$: $4y = 20$",
      "options": [
        { "id": "a", "text": "$y = 4$" },
        { "id": "b", "text": "$y = 5$" },
        { "id": "c", "text": "$y = 16$" },
        { "id": "d", "text": "$y = 80$" }
      ],
      "correctOptionId": "b",
      "explanation": "$y$ is multiplied by 4, so divide both sides by 4: $\\frac{4y}{4} = \\frac{20}{4}$, giving $y = 5$. Check: $4 \\times 5 = 20$.",
      "distractorRationale": {
        "c": "Subtracted 4 instead of dividing",
        "d": "Multiplied by 4 instead of dividing"
      },
      "misconceptionTags": ["inverse-operation"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
        "reviewStatus": "published",
        "verified": true
