    {
      "id": "sec.mathematics.algebra.linear-equations.q008",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o4"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "A trader sells oranges at ₦25 each and charges a fixed ₦50 delivery fee. A customer paid ₦350 in total. How many oranges did the customer buy?",
      "options": [
        { "id": "a", "text": "10" },
        { "id": "b", "text": "12" },
        { "id": "c", "text": "14" },
        { "id": "d", "text": "16" }
      ],
      "correctOptionId": "b",
      "explanation": "Let $n$ be the number of oranges. Then $25n + 50 = 350$. Subtract 50 from both sides to get $25n = 300$, then divide by 25 to get $n = 12$. Check: $25(12) + 50 = 300 + 50 = 350$.",
      "distractorRationale": {
        "a": "Divided 350 by 25 without removing the delivery fee first, then rounded",
        "c": "Added the delivery fee instead of subtracting it",
        "d": "Divided 400 by 25"
      },
      "misconceptionTags": ["translation-error"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
        "reviewStatus": "published",
        "verified": true
      }
    },
    {
      "id": "sec.mathematics.algebra.linear-equations.q009",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o2"],
      "type": "true_false",
      "difficulty": 1,
      "stem": "To solve $2x + 6 = 14$, you should divide both sides by 2 before subtracting 6.",
      "options": [
        { "id": "a", "text": "True" },
        { "id": "b", "text": "False" }
      ],
      "correctOptionId": "b",
      "explanation": "False. Undo addition and subtraction before multiplication and division. Subtract 6 first to get $2x = 8$, then divide by 2 to get $x = 4$. Dividing first is valid only if you divide every term, which is slower and error-prone.",
      "misconceptionTags": ["operation-order"],
      "examMeta": { "board": "internal", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
        "reviewStatus": "published",
        "verified": true
      }
    },
    {
      "id": "sec.mathematics.algebra.linear-equations.q010",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o3", "sec.mathematics.algebra.linear-equations.o4"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "The sum of three consecutive integers is 72. What is the smallest of the three integers?",
      "options": [
        { "id": "a", "text": "22" },
        { "id": "b", "text": "23" },
        { "id": "c", "text": "24" },
        { "id": "d", "text": "25" }
      ],
      "correctOptionId": "b",
      "explanation": "Let the smallest integer be $n$. The three consecutive integers are $n$, $n+1$ and $n+2$, so $3n + 3 = 72$. Subtract 3 from both sides to get $3n = 69$, then divide by 3 to get $n = 23$. Check: $23 + 24 + 25 = 72$.",
      "distractorRationale": {
        "a": "Solved 3n = 66 by forgetting one of the +1 terms",
        "c": "Gave the middle integer rather than the smallest",
        "d": "Gave the largest integer rather than the smallest"
      },
      "misconceptionTags": ["translation-error"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
