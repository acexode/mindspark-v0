    {
      "id": "sec.mathematics.algebra.linear-equations.q004",
      "subtopicId": "sec.mathematics.algebra.linear-equations",
      "objectiveIds": ["sec.mathematics.algebra.linear-equations.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Solve for $m$: $5m - 3 = 22$",
      "options": [
        { "id": "a", "text": "$m = 3.8$" },
        { "id": "b", "text": "$m = 5$" },
        { "id": "c", "text": "$m = 19$" },
        { "id": "d", "text": "$m = 25$" }
      ],
      "correctOptionId": "b",
      "explanation": "Add 3 to both sides to get $5m = 25$, then divide by 5 to get $m = 5$. Check: $5(5) - 3 = 25 - 3 = 22$.",
      "distractorRationale": {
        "a": "Subtracted 3 instead of adding, giving 19 ÷ 5",
        "c": "Subtracted 3 from 22 and stopped",
        "d": "Stopped at 5m = 25 without dividing"
      },
      "misconceptionTags": ["inverse-operation"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": {
        "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }],
        "reviewStatus": "published",
