{
  "subtopicId": "sec.mathematics.algebra.expressions",
  "questions": [
    {
      "id": "sec.mathematics.algebra.expressions.q001",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "In the expression $7a - 4b + 9$, what is the constant term?",
      "options": [
        { "id": "a", "text": "$7$" },
        { "id": "b", "text": "$-4$" },
        { "id": "c", "text": "$9$" },
        { "id": "d", "text": "$a$" }
      ],
      "correctOptionId": "c",
      "explanation": "A constant is a term with no variable attached. In $7a - 4b + 9$, the terms $7a$ and $-4b$ both contain variables, so the constant is $9$.",
      "distractorRationale": { "a": "7 is a coefficient, not a constant", "b": "−4 is a coefficient of b" },
      "misconceptionTags": ["term-identification"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q002",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "What is the coefficient of $x$ in the expression $-5x + 12$?",
      "options": [
        { "id": "a", "text": "$5$" },
        { "id": "b", "text": "$-5$" },
        { "id": "c", "text": "$12$" },
        { "id": "d", "text": "$-12$" }
      ],
      "correctOptionId": "b",
      "explanation": "The coefficient is the number multiplying the variable, including its sign. In $-5x + 12$ the term is $-5x$, so the coefficient is $-5$.",
      "distractorRationale": { "a": "Dropped the negative sign, which belongs to the term", "c": "12 is the constant" },
      "misconceptionTags": ["sign-error"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q003",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o2"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Simplify: $4x + 7x$",
      "options": [
        { "id": "a", "text": "$11x$" },
        { "id": "b", "text": "$11x^2$" },
        { "id": "c", "text": "$28x$" },
        { "id": "d", "text": "$3x$" }
      ],
      "correctOptionId": "a",
      "explanation": "$4x$ and $7x$ are like terms because both contain $x$ to the power of one. Add the coefficients: $4 + 7 = 11$, giving $11x$. The power of $x$ does not change when adding.",
      "distractorRationale": { "b": "Multiplied the variables instead of adding coefficients", "c": "Multiplied 4 by 7", "d": "Subtracted instead of adding" },
      "misconceptionTags": ["collecting-like-terms"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q004",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Simplify: $6a + 3b - 2a + 5b$",
      "options": [
        { "id": "a", "text": "$4a + 8b$" },
        { "id": "b", "text": "$8a + 8b$" },
        { "id": "c", "text": "$12ab$" },
        { "id": "d", "text": "$4a + 2b$" }
      ],
      "correctOptionId": "a",
      "explanation": "Group like terms: $(6a - 2a) + (3b + 5b)$. The $a$ terms give $4a$ and the $b$ terms give $8b$. Since $a$ and $b$ are different variables they cannot be combined, so the answer is $4a + 8b$.",
      "distractorRationale": { "b": "Added 6a and 2a instead of subtracting", "c": "Combined unlike terms", "d": "Subtracted the b terms instead of adding" },
      "misconceptionTags": ["collecting-like-terms", "sign-error"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q005",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Which pair are like terms?",
      "options": [
        { "id": "a", "text": "$3x$ and $3y$" },
        { "id": "b", "text": "$5x^2$ and $5x$" },
        { "id": "c", "text": "$2ab$ and $-7ab$" },
        { "id": "d", "text": "$4a$ and $4a^2$" }
      ],
      "correctOptionId": "c",
      "explanation": "Like terms must have exactly the same variables raised to the same powers. $2ab$ and $-7ab$ both contain $ab$, so they are like terms and can be combined to give $-5ab$. The other pairs differ in either variable or power.",
      "distractorRationale": { "a": "Different variables", "b": "Different powers of x", "d": "Different powers of a" },
      "misconceptionTags": ["collecting-like-terms"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q006",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o3"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "If $x = 4$, what is the value of $3x + 5$?",
      "options": [
        { "id": "a", "text": "$12$" },
        { "id": "b", "text": "$17$" },
        { "id": "c", "text": "$32$" },
        { "id": "d", "text": "$35$" }
      ],
      "correctOptionId": "b",
      "explanation": "Substitute $x = 4$ into the expression: $3(4) + 5$. Multiply first by BODMAS: $12 + 5 = 17$.",
      "distractorRationale": { "a": "Stopped after multiplying and forgot to add 5", "c": "Added before multiplying: 3 × (4 + 5)" },
      "misconceptionTags": ["operation-order"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q007",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o3"],
      "type": "numeric",
      "difficulty": 2,
      "stem": "Evaluate $2y^2 - 3$ when $y = 3$. Give a number only.",
      "correctValue": 15,
      "explanation": "Substitute $y = 3$: $2(3)^2 - 3$. Apply the power first: $3^2 = 9$. Then multiply: $2 \\times 9 = 18$. Finally subtract: $18 - 3 = 15$.",
      "misconceptionTags": ["operation-order"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q008",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o3"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Evaluate $x^2 - 4x$ when $x = -2$.",
      "options": [
        { "id": "a", "text": "$-4$" },
        { "id": "b", "text": "$4$" },
        { "id": "c", "text": "$12$" },
        { "id": "d", "text": "$-12$" }
      ],
      "correctOptionId": "c",
      "explanation": "Substitute with brackets: $(-2)^2 - 4(-2)$. A negative squared is positive, so $(-2)^2 = 4$. Then $-4 \\times -2 = +8$. So $4 + 8 = 12$.",
      "distractorRationale": { "a": "Treated (−2)² as −4", "b": "Dropped the second term", "d": "Made both terms negative" },
      "misconceptionTags": ["sign-error", "substitution-error"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q009",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o1"],
      "type": "true_false",
      "difficulty": 1,
      "stem": "$4x + 7$ is an equation.",
      "options": [
        { "id": "a", "text": "True" },
        { "id": "b", "text": "False" }
      ],
      "correctOptionId": "b",
      "explanation": "False. $4x + 7$ is an expression because it has no equals sign. It becomes an equation only when set equal to something, for example $4x + 7 = 19$.",
      "misconceptionTags": ["term-identification"],
      "examMeta": { "board": "internal", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.algebra.expressions.q010",
      "subtopicId": "sec.mathematics.algebra.expressions",
      "objectiveIds": ["sec.mathematics.algebra.expressions.o2", "sec.mathematics.algebra.expressions.o3"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Simplify $3(2x + 4) - 2(x - 1)$.",
      "options": [
        { "id": "a", "text": "$4x + 10$" },
        { "id": "b", "text": "$4x + 14$" },
        { "id": "c", "text": "$8x + 10$" },
        { "id": "d", "text": "$4x + 11$" }
      ],
      "correctOptionId": "b",
      "explanation": "Expand each bracket: $3(2x + 4) = 6x + 12$ and $-2(x - 1) = -2x + 2$. Note the minus multiplies both terms, so $-2 \\times -1 = +2$. Now collect like terms: $6x - 2x = 4x$ and $12 + 2 = 14$, giving $4x + 14$.",
      "distractorRationale": { "a": "Took −2 × −1 as −2", "c": "Failed to subtract the 2x", "d": "Arithmetic slip on the constants" },
      "misconceptionTags": ["distributive-law", "sign-error"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-wave0", "title": "Mindspark reference pack", "type": "authored" }], "reviewStatus": "published", "verified": true }
    }
  ]
}
