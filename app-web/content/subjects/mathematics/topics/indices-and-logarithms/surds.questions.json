{
  "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
  "questions": [
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q001",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Simplify $\\sqrt{50}$.",
      "options": [
        { "id": "a", "text": "$2\\sqrt{5}$" },
        { "id": "b", "text": "$5\\sqrt{2}$" },
        { "id": "c", "text": "$25\\sqrt{2}$" },
        { "id": "d", "text": "$10\\sqrt{5}$" }
      ],
      "correctOptionId": "b",
      "explanation": "The largest perfect square dividing 50 is 25, so $\\sqrt{50} = \\sqrt{25 \\times 2} = \\sqrt{25}\\sqrt{2} = 5\\sqrt{2}$. Checking, $5\\sqrt{2} \\approx 7.07$ and $\\sqrt{50} \\approx 7.07$.",
      "distractorRationale": {
        "a": "Used the factor pair 2 × 25 but took the root of the wrong factor",
        "c": "Took 25 out without taking its square root",
        "d": "Used the non-square factor 10 and left √5 behind"
      },
      "misconceptionTags": ["simplifying-surds"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q002",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Simplify $\\sqrt{75}$.",
      "options": [
        { "id": "a", "text": "$3\\sqrt{5}$" },
        { "id": "b", "text": "$5\\sqrt{3}$" },
        { "id": "c", "text": "$15\\sqrt{5}$" },
        { "id": "d", "text": "$25\\sqrt{3}$" }
      ],
      "correctOptionId": "b",
      "explanation": "Since $75 = 25 \\times 3$ and 25 is a perfect square, $\\sqrt{75} = 5\\sqrt{3}$. Always look for the largest square factor so the surd is fully simplified.",
      "distractorRationale": {
        "a": "Swapped which factor came out of the root",
        "c": "Used 15 as a square factor, but 15 is not a perfect square",
        "d": "Brought 25 outside without taking its root"
      },
      "misconceptionTags": ["simplifying-surds"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q003",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o2"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Simplify $3\\sqrt{2} + 5\\sqrt{2}$.",
      "options": [
        { "id": "a", "text": "$8\\sqrt{2}$" },
        { "id": "b", "text": "$8\\sqrt{4}$" },
        { "id": "c", "text": "$15\\sqrt{2}$" },
        { "id": "d", "text": "$8$" }
      ],
      "correctOptionId": "a",
      "explanation": "These are like surds because both contain $\\sqrt{2}$, so add the coefficients and keep the surd unchanged: $3 + 5 = 8$, giving $8\\sqrt{2}$. It works just like $3x + 5x = 8x$.",
      "distractorRationale": {
        "b": "Added the numbers under the root as well as the coefficients",
        "c": "Multiplied the coefficients instead of adding them",
        "d": "Dropped the surd entirely"
      },
      "misconceptionTags": ["like-surds"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q004",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o1", "sec.mathematics.indices-and-logarithms.surds.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Simplify $\\sqrt{18} + \\sqrt{32}$.",
      "options": [
        { "id": "a", "text": "$\\sqrt{50}$" },
        { "id": "b", "text": "$5\\sqrt{2}$" },
        { "id": "c", "text": "$7\\sqrt{2}$" },
        { "id": "d", "text": "$12\\sqrt{2}$" }
      ],
      "correctOptionId": "c",
      "explanation": "Simplify each surd first: $\\sqrt{18} = 3\\sqrt{2}$ and $\\sqrt{32} = 4\\sqrt{2}$. They are now like surds, so the sum is $7\\sqrt{2}$. Note that $\\sqrt{18} + \\sqrt{32} \\neq \\sqrt{50}$, because roots do not add across a plus sign.",
      "distractorRationale": {
        "a": "Added the numbers under the roots, which is not a valid rule",
        "b": "This is $\\sqrt{50}$ simplified, so it repeats the same invalid step",
        "d": "Multiplied 3 by 4 instead of adding them"
      },
      "misconceptionTags": ["like-surds", "root-of-a-sum"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q005",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Simplify $\\sqrt{6} \\times \\sqrt{3}$.",
      "options": [
        { "id": "a", "text": "$3\\sqrt{2}$" },
        { "id": "b", "text": "$\\sqrt{9}$" },
        { "id": "c", "text": "$2\\sqrt{3}$" },
        { "id": "d", "text": "$18$" }
      ],
      "correctOptionId": "a",
      "explanation": "Multiplying surds multiplies the numbers under the roots: $\\sqrt{6}\\sqrt{3} = \\sqrt{18}$. Then $\\sqrt{18} = \\sqrt{9 \\times 2} = 3\\sqrt{2}$.",
      "distractorRationale": {
        "b": "Added the numbers under the roots instead of multiplying",
        "c": "Divided 6 by 3 rather than multiplying",
        "d": "Multiplied correctly but forgot to take the square root"
      },
      "misconceptionTags": ["multiplying-surds"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q006",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o3"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Rationalise the denominator of $\\frac{6}{\\sqrt{3}}$.",
      "options": [
        { "id": "a", "text": "$2\\sqrt{3}$" },
        { "id": "b", "text": "$6\\sqrt{3}$" },
        { "id": "c", "text": "$\\frac{\\sqrt{3}}{2}$" },
        { "id": "d", "text": "$3\\sqrt{2}$" }
      ],
      "correctOptionId": "a",
      "explanation": "Multiply top and bottom by $\\sqrt{3}$: $\\frac{6\\sqrt{3}}{3} = 2\\sqrt{3}$. Multiplying by $\\frac{\\sqrt{3}}{\\sqrt{3}}$ is multiplying by 1, so the value does not change.",
      "distractorRationale": {
        "b": "Multiplied the numerator by $\\sqrt{3}$ but forgot that the denominator becomes 3",
        "c": "Inverted the fraction during the process",
        "d": "Swapped the 3 and the 2 in the final simplification"
      },
      "misconceptionTags": ["rationalising"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q007",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o4"],
      "type": "numeric",
      "difficulty": 2,
      "stem": "Evaluate $(\\sqrt{5} + \\sqrt{2})(\\sqrt{5} - \\sqrt{2})$. Give a number only.",
      "correctValue": 3,
      "explanation": "This is a difference of two squares: $(\\sqrt{5})^2 - (\\sqrt{2})^2 = 5 - 2 = 3$. The two cross terms, $-\\sqrt{10}$ and $+\\sqrt{10}$, cancel, which is exactly why conjugates rationalise denominators.",
      "misconceptionTags": ["conjugate", "difference-of-two-squares"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q008",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Expand and simplify $(2 + \\sqrt{3})^2$.",
      "options": [
        { "id": "a", "text": "$7$" },
        { "id": "b", "text": "$4 + 3$" },
        { "id": "c", "text": "$7 + 4\\sqrt{3}$" },
        { "id": "d", "text": "$7 + 2\\sqrt{3}$" }
      ],
      "correctOptionId": "c",
      "explanation": "Expanding gives $(2 + \\sqrt{3})(2 + \\sqrt{3}) = 4 + 2\\sqrt{3} + 2\\sqrt{3} + 3 = 7 + 4\\sqrt{3}$. The two identical middle terms combine, so the coefficient of $\\sqrt{3}$ is 4, not 2.",
      "distractorRationale": {
        "a": "Squared each term separately and dropped the middle terms",
        "b": "Same error, left unsimplified",
        "d": "Counted only one of the two middle terms"
      },
      "misconceptionTags": ["expanding-surds"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q009",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o4"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Rationalise the denominator of $\\frac{1}{3 - \\sqrt{2}}$.",
      "options": [
        { "id": "a", "text": "$\\frac{3 + \\sqrt{2}}{7}$" },
        { "id": "b", "text": "$\\frac{3 - \\sqrt{2}}{7}$" },
        { "id": "c", "text": "$\\frac{3 + \\sqrt{2}}{11}$" },
        { "id": "d", "text": "$\\frac{3 + \\sqrt{2}}{9}$" }
      ],
      "correctOptionId": "a",
      "explanation": "Multiply top and bottom by the conjugate $3 + \\sqrt{2}$. The denominator becomes $3^2 - (\\sqrt{2})^2 = 9 - 2 = 7$ and the numerator becomes $3 + \\sqrt{2}$, giving $\\frac{3 + \\sqrt{2}}{7}$.",
      "distractorRationale": {
        "b": "Multiplied by the same expression rather than the conjugate, so the surd remains in the working",
        "c": "Added 9 and 2 instead of subtracting",
        "d": "Forgot to subtract the 2 when squaring the surd"
      },
      "misconceptionTags": ["conjugate", "rationalising"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.surds.q010",
      "subtopicId": "sec.mathematics.indices-and-logarithms.surds",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.surds.o4"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Simplify $\\frac{\\sqrt{3} + 1}{\\sqrt{3} - 1}$.",
      "options": [
        { "id": "a", "text": "$2 + \\sqrt{3}$" },
        { "id": "b", "text": "$2 - \\sqrt{3}$" },
        { "id": "c", "text": "$\\sqrt{3}$" },
        { "id": "d", "text": "$4 + 2\\sqrt{3}$" }
      ],
      "correctOptionId": "a",
      "explanation": "Multiply top and bottom by the conjugate $\\sqrt{3} + 1$. The denominator becomes $3 - 1 = 2$ and the numerator becomes $(\\sqrt{3} + 1)^2 = 3 + 2\\sqrt{3} + 1 = 4 + 2\\sqrt{3}$. Dividing by 2 gives $2 + \\sqrt{3}$.",
      "distractorRationale": {
        "b": "Used the conjugate $\\sqrt{3} - 1$ on the numerator, flipping the sign",
        "c": "Cancelled the 1s, which is not allowed because they are terms, not factors",
        "d": "Correct numerator but forgot to divide by the denominator 2"
      },
      "misconceptionTags": ["conjugate", "cancelling-terms"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    }
  ]
}
