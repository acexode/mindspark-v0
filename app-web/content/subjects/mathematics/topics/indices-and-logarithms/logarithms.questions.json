{
  "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
  "questions": [
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q001",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o1"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Express $2^5 = 32$ in logarithmic form.",
      "options": [
        { "id": "a", "text": "$\\log_2 32 = 5$" },
        { "id": "b", "text": "$\\log_5 32 = 2$" },
        { "id": "c", "text": "$\\log_{32} 2 = 5$" },
        { "id": "d", "text": "$\\log_2 5 = 32$" }
      ],
      "correctOptionId": "a",
      "explanation": "In $a^x = N$ the base $a$ stays the base of the logarithm, the answer $N$ goes inside, and the index $x$ becomes the value. Since $2^5 = 32$, we get $\\log_2 32 = 5$.",
      "distractorRationale": {
        "b": "Swapped the base and the index",
        "c": "Swapped the base with the number",
        "d": "Swapped the number with the index"
      },
      "misconceptionTags": ["log-index-conversion"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q002",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o3"],
      "type": "mcq",
      "difficulty": 1,
      "stem": "Evaluate $\\log_{10} 1000$.",
      "options": [
        { "id": "a", "text": "$2$" },
        { "id": "b", "text": "$3$" },
        { "id": "c", "text": "$10$" },
        { "id": "d", "text": "$100$" }
      ],
      "correctOptionId": "b",
      "explanation": "You are being asked what power of 10 gives 1000. Since $10^3 = 1000$, the logarithm is 3. Counting the zeros in a power of ten gives the base-10 logarithm directly.",
      "distractorRationale": {
        "a": "Counted one zero too few, which would give 100",
        "c": "Gave the base rather than the index",
        "d": "Divided 1000 by 10 rather than finding the index"
      },
      "misconceptionTags": ["common-logarithm"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q003",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Simplify $\\log_{10} 8 + \\log_{10} 125$.",
      "options": [
        { "id": "a", "text": "$1$" },
        { "id": "b", "text": "$2$" },
        { "id": "c", "text": "$3$" },
        { "id": "d", "text": "$\\log_{10} 133$" }
      ],
      "correctOptionId": "c",
      "explanation": "The product law turns the sum of logs into the log of a product: $\\log_{10}(8 \\times 125) = \\log_{10} 1000 = 3$. Recognising that $8 \\times 125 = 1000$ is what makes this a one-line question.",
      "distractorRationale": {
        "a": "Left the answer as if the product were 10",
        "b": "Took the product as 100 instead of 1000",
        "d": "Added the numbers inside the logs instead of multiplying them"
      },
      "misconceptionTags": ["log-product-law"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q004",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Simplify $\\log_{10} 50 - \\log_{10} 5$.",
      "options": [
        { "id": "a", "text": "$1$" },
        { "id": "b", "text": "$10$" },
        { "id": "c", "text": "$45$" },
        { "id": "d", "text": "$\\log_{10} 45$" }
      ],
      "correctOptionId": "a",
      "explanation": "The quotient law gives $\\log_{10}\\left(\\frac{50}{5}\\right) = \\log_{10} 10 = 1$, because the logarithm of the base is always 1.",
      "distractorRationale": {
        "b": "Stopped at the number 10 without taking its logarithm",
        "c": "Subtracted the numbers rather than dividing them",
        "d": "Same subtraction error, left in log form"
      },
      "misconceptionTags": ["log-quotient-law"],
      "examMeta": { "board": "NECO", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q005",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o1"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Evaluate $\\log_3 81$.",
      "options": [
        { "id": "a", "text": "$3$" },
        { "id": "b", "text": "$4$" },
        { "id": "c", "text": "$9$" },
        { "id": "d", "text": "$27$" }
      ],
      "correctOptionId": "b",
      "explanation": "You need the power of 3 that gives 81. Since $3^4 = 81$, the answer is 4. Building up the powers of 3 — 3, 9, 27, 81 — is the fastest way to see it.",
      "distractorRationale": {
        "a": "Gave the base instead of the index",
        "c": "This is $81 \\div 9$, not a logarithm",
        "d": "This is $3^3$, one power short of 81"
      },
      "misconceptionTags": ["log-index-conversion"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q006",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o2"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Evaluate $\\log_5 1$.",
      "options": [
        { "id": "a", "text": "$0$" },
        { "id": "b", "text": "$1$" },
        { "id": "c", "text": "$5$" },
        { "id": "d", "text": "$\\frac{1}{5}$" }
      ],
      "correctOptionId": "a",
      "explanation": "You need the power of 5 that gives 1. Since $5^0 = 1$, the logarithm is 0. In fact $\\log_a 1 = 0$ for every valid base.",
      "distractorRationale": {
        "b": "Confused $\\log_a 1$ with $\\log_a a$, which is the one that equals 1",
        "c": "Gave the base",
        "d": "Treated the expression as a division"
      },
      "misconceptionTags": ["log-of-one"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q007",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o2", "sec.mathematics.indices-and-logarithms.logarithms.o3"],
      "type": "mcq",
      "difficulty": 2,
      "stem": "Given that $\\log_{10} 2 = 0.3010$, find $\\log_{10} 8$.",
      "options": [
        { "id": "a", "text": "$0.6020$" },
        { "id": "b", "text": "$0.9030$" },
        { "id": "c", "text": "$2.4080$" },
        { "id": "d", "text": "$1.2040$" }
      ],
      "correctOptionId": "b",
      "explanation": "Write 8 as a power of 2: $8 = 2^3$. The power law then gives $\\log_{10} 8 = 3 \\log_{10} 2 = 3 \\times 0.3010 = 0.9030$.",
      "distractorRationale": {
        "a": "Used $8 = 2^2$, doubling instead of trebling",
        "c": "Multiplied by 8 rather than by the index 3",
        "d": "Multiplied by 4 instead of 3"
      },
      "misconceptionTags": ["log-power-law"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q008",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o3"],
      "type": "numeric",
      "difficulty": 2,
      "stem": "Evaluate $\\log_{10} 0.001$. Give a number only.",
      "correctValue": -3,
      "explanation": "Write the number as a power of 10: $0.001 = 10^{-3}$, so the logarithm is $-3$. Any number between 0 and 1 has a negative base-10 logarithm, which is a useful check.",
      "misconceptionTags": ["negative-logarithm"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q009",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o4"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Solve $\\log_2 x + \\log_2 (x - 2) = 3$.",
      "options": [
        { "id": "a", "text": "$x = 4$" },
        { "id": "b", "text": "$x = -2$" },
        { "id": "c", "text": "$x = 4$ or $x = -2$" },
        { "id": "d", "text": "$x = 5$" }
      ],
      "correctOptionId": "a",
      "explanation": "The product law gives $\\log_2 \\big(x(x - 2)\\big) = 3$, so $x(x - 2) = 2^3 = 8$. That gives $x^2 - 2x - 8 = 0$, which factorises as $(x - 4)(x + 2) = 0$. The root $x = -2$ must be rejected because $\\log_2(-2)$ is undefined, leaving $x = 4$.",
      "distractorRationale": {
        "b": "Chose the root that makes both logarithms undefined",
        "c": "Kept both roots without checking that each keeps the logarithms valid",
        "d": "Added the 3 and the 2 rather than solving the quadratic"
      },
      "misconceptionTags": ["log-equation", "rejecting-roots"],
      "examMeta": { "board": "JAMB", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    },
    {
      "id": "sec.mathematics.indices-and-logarithms.logarithms.q010",
      "subtopicId": "sec.mathematics.indices-and-logarithms.logarithms",
      "objectiveIds": ["sec.mathematics.indices-and-logarithms.logarithms.o2"],
      "type": "mcq",
      "difficulty": 3,
      "stem": "Simplify $\\log_{10} 45 + \\log_{10} 2 - \\log_{10} 9$.",
      "options": [
        { "id": "a", "text": "$0$" },
        { "id": "b", "text": "$1$" },
        { "id": "c", "text": "$2$" },
        { "id": "d", "text": "$\\log_{10} 38$" }
      ],
      "correctOptionId": "b",
      "explanation": "Combine using the product and quotient laws: $\\log_{10}\\left(\\frac{45 \\times 2}{9}\\right) = \\log_{10}\\left(\\frac{90}{9}\\right) = \\log_{10} 10 = 1$.",
      "distractorRationale": {
        "a": "Would require the argument to reduce to 1, not 10",
        "c": "Took the argument as 100 rather than 10",
        "d": "Added and subtracted the numbers themselves instead of using the laws"
      },
      "misconceptionTags": ["log-product-law", "log-quotient-law"],
      "examMeta": { "board": "WAEC", "style": "exam-pattern" },
      "provenance": { "sources": [{ "id": "authored-mindspark-maths", "title": "Mindspark authored Mathematics content", "type": "authored" }], "reviewStatus": "published", "verified": true }
    }
  ]
