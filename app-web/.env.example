# Mindspark — Environment Variables

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/mindspark?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI Tutor — tried in this order: Ollama, then OpenAI (if a key is set), then built-in guidance
# Ollama runs locally: `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=60000
# OPENAI_API_KEY=sk-...

# Online tutor model (optional). Any OpenAI-compatible API: set all three together.
# Student questions and lesson text are sent to this provider, and some free tiers keep prompts for
# training. Check the provider's data policy before using it with students.
# Groq:        https://api.groq.com/openai/v1
# OpenRouter:  https://openrouter.ai/api/v1
# CLOUD_AI_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_AI_API_KEY=
# CLOUD_AI_MODEL=
# Order tried, first to last. Default: ollama,cloud,openai. For online first: cloud,ollama
# TUTOR_PROVIDER_ORDER=cloud,ollama

# Vercel Blob (curriculum documents)
BLOB_READ_WRITE_TOKEN=

# Optional: Inngest (background jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: Sentry
SENTRY_DSN=
