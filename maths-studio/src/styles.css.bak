:root{font-family:"Source Sans 3",Arial,sans-serif;color:#171717;background:#faf7ef;font-synthesis:none;--paper:#faf7ef;--blue:#0c4dcc;--red:#c83d32;--green:#148b5b;--rule:#d9d3c6}*{box-sizing:border-box}button,select{font:inherit}button{color:inherit}body{margin:0;min-width:1060px;min-height:100vh;background:var(--paper);-webkit-font-smoothing:antialiased}button:focus-visible,select:focus-visible{outline:3px solid #0c4dcc47;outline-offset:2px}.app-shell{min-height:100vh;display:grid;grid-template-columns:148px minmax(680px,1fr) 322px}.sidebar{border-right:1px solid var(--rule);display:flex;flex-direction:column;min-height:100vh;background:#fbf8f1}.brand{font:600 29px/.86 "Source Serif 4",Georgia,serif;padding:29px 25px 42px;letter-spacing:-.8px}.brand span{display:block;width:94px;height:3px;margin-top:12px;background:var(--blue);transform:rotate(-3deg);border-radius:10px}.sidebar nav{display:flex;flex-direction:column;gap:14px}.nav-item{height:60px;border:0;background:transparent;display:flex;align-items:center;gap:15px;padding:0 26px;cursor:pointer;position:relative;font-size:15px}.nav-item:hover{background:#f0ece2}.nav-item.active{color:var(--blue);font-weight:600}.nav-item.active:before{content:"";position:absolute;width:4px;height:48px;background:var(--blue);left:0}.offline{margin-top:auto;padding:24px 27px 31px;display:flex;gap:10px;align-items:center;font-size:13px}.offline small{display:block;margin-top:2px;color:#198655}.offline small:before{content:"";display:inline-block;width:5px;height:5px;background:#198655;border-radius:50%;margin-right:6px;vertical-align:2px}.workspace{min-width:0;display:grid;grid-template-rows:auto auto 1fr}.lesson-header{padding:25px 40px 23px;border-bottom:1px solid var(--rule)}.breadcrumbs{display:flex;gap:8px;align-items:center;color:#393939;font-size:14px}.breadcrumbs svg{width:13px;color:#999}.lesson-title-row{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-top:25px}h1,h2,h3,p{margin:0}h1{font:600 37px/1.05 "Source Serif 4",Georgia,serif;letter-spacing:-1px}.lesson-title-row p{font:400 22px/1.4 "Source Serif 4",Georgia,serif;margin-top:8px}.lesson-title-row strong{color:var(--blue);font-weight:500}.step-rail{display:flex;align-items:flex-start;gap:34px;min-width:360px}.step{flex:1;text-align:center;position:relative;color:#5a5a5a;font-size:13px}.step:after{content:"";position:absolute;height:1px;width:44px;background:#aaa;top:15px;left:calc(50% + 20px)}.step:last-child:after{display:none}.step-dot{width:30px;height:30px;border:1px solid #777;border-radius:50%;display:flex;justify-content:center;align-items:center;margin:0 auto 7px;background:var(--paper);font-weight:600}.step-dot svg{width:16px}.step.active,.step.done{color:var(--blue);font-weight:600}.step.active .step-dot{background:var(--blue);color:#fff;border-color:var(--blue)}.step.done .step-dot{background:var(--green);color:#fff;border-color:var(--green)}.worked-example{display:grid;grid-template-columns:150px 1fr;gap:20px;align-items:center;min-height:112px;padding:17px 40px;border-bottom:1px solid var(--rule)}.hand-label{color:var(--blue);font:italic 600 21px/1.2 "Source Serif 4",Georgia,serif;display:inline-block;border-bottom:2px solid var(--blue);padding-bottom:3px;transform:rotate(-1deg)}.example-flow{display:flex;align-items:center;justify-content:space-between;gap:12px;font:400 17px/1.2 "Source Serif 4",Georgia,serif}.example-flow em{font-size:13px;color:var(--red)}.example-flow svg{width:19px;flex:none}.notebook{position:relative;min-height:580px;padding:23px 42px 20px 74px;background-color:#fbfaf5;background-image:linear-gradient(#dceaf1 1px,transparent 1px),linear-gradient(90deg,#dceaf1 1px,transparent 1px);background-size:31px 31px}.notebook:before{content:"";position:absolute;left:72px;top:0;bottom:0;width:1px;background:#e88686}.notebook-top{display:flex;justify-content:space-between;align-items:center;gap:30px;padding-left:36px}.notebook-top p{margin-top:8px;font-size:16px}select{border:1px solid var(--blue);background:#fff;padding:11px 15px;color:var(--blue);font-weight:600;min-width:245px}.equation-lines{display:grid;grid-template-columns:42px minmax(360px,1fr) minmax(180px,.72fr);align-items:center;row-gap:9px;margin-top:24px}.line-number{font:400 20px "Source Serif 4",Georgia,serif}.line-number.success{color:var(--green);font-weight:600}.equation{font:italic 400 34px/1.2 "Source Serif 4",Georgia,serif;padding:12px 28px;min-height:58px;letter-spacing:2px}.equation span{color:var(--blue)}.input-line{background:#ffffffa3;border:2px solid var(--blue);box-shadow:0 1px 0 #0c4dcc14}.input-line.checked{border-color:var(--green)}.input-line i{display:inline-block;height:34px;width:2px;background:var(--blue);vertical-align:-7px;margin-left:5px;animation:blink 1.15s steps(1) infinite}@keyframes blink{50%{opacity:0}}.fraction-row{display:flex;gap:18px;align-items:center}.fraction-row>span{display:flex;flex-direction:column;color:#171717;text-align:center;line-height:.8}.fraction-row u{text-decoration:none;padding:3px 9px}.fraction-row u:first-child{border-bottom:1.5px solid #222}.annotation{font:italic 400 18px/1.35 "Source Serif 4",Georgia,serif;color:#747474;padding-left:24px}.annotation:before{content:"←";font-style:normal;margin-right:13px}.annotation.red{color:var(--red)}.annotation.green{color:var(--green)}.notebook-footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;margin-top:21px;padding-left:7px}.hint-button,.craft-actions button{border:0;background:transparent;color:var(--blue);border-bottom:1px dashed var(--blue);display:flex;align-items:center;gap:7px;padding:5px 0;cursor:pointer}.check-button{border:0;background:var(--blue);color:#fff;padding:15px 27px;min-width:250px;font:600 17px "Source Serif 4",Georgia,serif;box-shadow:0 2px 0 #083798;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:17px}.check-button:hover{background:#083ea7}.craft-actions{justify-self:end;display:flex;align-items:center;gap:10px;color:var(--blue)}.success-toast{position:absolute;right:28px;bottom:22px;background:#e6f5ec;color:#0d6843;border:1px solid #94c7ac;padding:10px 13px;display:flex;align-items:center;gap:9px;font-weight:600;box-shadow:0 4px 14px #283c2d1f}.success-toast button{border:0;background:transparent;display:flex;cursor:pointer;padding:0 0 0 10px}.right-panel{border-left:1px solid var(--rule);background:#fbf8f1;min-width:0}.right-panel.collapsed{width:78px}.tutor-title{height:64px;padding:0 25px;border-bottom:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between}.tutor-title h2{color:var(--blue);font:600 23px "Source Serif 4",Georgia,serif}.tutor-title button,.section-head button{border:0;background:transparent;color:var(--blue);cursor:pointer;display:flex;gap:6px;align-items:center}.tutor-note{margin:19px 20px;padding:14px 17px 15px 38px;border:1px solid #ded8cc;background-color:#fcfaf4;background-image:linear-gradient(#e7e3d8 1px,transparent 1px);background-size:100% 26px;min-height:190px;position:relative}.tutor-note:before{content:"";position:absolute;left:22px;top:0;bottom:0;width:1px;background:#e89b9b}.note-kicker{font:italic 400 14px "Source Serif 4",Georgia,serif;margin-bottom:14px}.note-kicker span{position:absolute;left:-10px;top:45px;width:29px;height:29px;border:1.5px solid var(--red);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--red);font-style:normal;background:#fff}.tutor-note p{font:italic 400 18px/1.35 "Source Serif 4",Georgia,serif}.tutor-note button{border:0;background:transparent;color:var(--blue);font-weight:600;padding:20px 0 0;display:flex;gap:8px;align-items:center;cursor:pointer}.progress-panel,.continue-panel{border-top:1px solid var(--rule);padding:18px 24px}.section-head{display:flex;justify-content:space-between;align-items:center}.progress-panel h3,.continue-panel h3{font:600 18px "Source Serif 4",Georgia,serif}.mastery-line{display:flex;align-items:center;gap:8px;font:400 17px "Source Serif 4",Georgia,serif;margin:12px 0}.mastery-line svg{width:15px}.mastery-line strong{color:var(--green);font-weight:500}.progress-track{height:8px;border-radius:10px;background:#dedddb;overflow:hidden;margin-bottom:17px}.progress-track span{display:block;width:68%;height:100%;background:var(--green)}.evidence p,.next-skill p{color:#747474;margin-bottom:6px}.evidence span{display:flex;align-items:center;gap:7px;margin:7px 0;font-size:14px}.evidence svg{border:1px solid var(--green);border-radius:50%;color:var(--green);padding:2px}.next-skill{border-top:1px solid var(--rule);margin-top:14px;padding-top:13px;display:flex;flex-direction:column;font-size:14px}.next-skill span{color:#666}.continue-panel button{width:100%;border:0;background:transparent;color:var(--blue);display:grid;grid-template-columns:23px 1fr 16px;align-items:center;text-align:left;padding:8px 0;cursor:pointer}.map-label{border-top:1px solid var(--rule);padding-top:13px;margin-top:5px;font-weight:600;font-size:13px}.map-preview{display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:4px}.map-preview>svg{width:15px;flex:none}.map-node{width:77px;height:77px;border:1.5px solid #969696;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;background:#faf8f2}.map-node.current{border:2px solid var(--blue);color:var(--blue)}@media(max-width:1200px){.app-shell{grid-template-columns:120px minmax(650px,1fr) 286px}.brand{padding-left:18px;font-size:25px}.nav-item{padding:0 18px;gap:10px}.lesson-header,.worked-example{padding-left:28px;padding-right:28px}.step-rail{min-width:310px;gap:22px}.example-flow{font-size:15px}.notebook{padding-right:24px}}
