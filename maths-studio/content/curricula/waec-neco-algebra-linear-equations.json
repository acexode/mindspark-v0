      "id": "linear-equations-balancing",
      "conceptId": "linear-equations",
      "title": "Solving Linear Equations by Balancing",
      "steps": [
        {
          "id": "hook",
          "type": "hook",
          "content": {
            "text": "Every equation is a balance. What you do to one side, you must do to the other."
          }
        },
        {
          "id": "concept",
          "type": "concept",
          "content": {
            "text": "To solve 3x + 5 = 20, first remove the constant by subtracting 5 from both sides."
          }
        },
        {
          "id": "worked",
          "type": "worked_example",
          "content": {
            "equation": "3x + 5 = 20",
            "steps": ["Subtract 5", "Simplify to 3x = 15", "Divide by 3", "x = 5"]
          }
        },
        {
          "id": "attempt",
          "type": "attempt",
          "content": {
            "interaction": "equation-balance",
            "initialEquation": "3x + 5 = 20"
          }
        },
        {
          "id": "recap",
          "type": "recap",
          "content": {
            "text": "Balancing means applying the same inverse operation to both sides."
          }
        }
      ]
    }
  ],
